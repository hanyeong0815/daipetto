# ===== Database (local) =====
# Spring と同じDB（daipetto）を読み取り専用で参照する。テーブルは Spring の Flyway が作成する
DB_HOST=localhost
DB_PORT=5432
DB_NAME=daipetto
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# ===== Internal API =====
# Spring API からの呼び出しを認証するキー。Spring 側（INTERNAL_API_KEY）と同じ値にする
INTERNAL_API_KEY=your_internal_api_key
