diff --git a/spring-api/src/test/java/koh/portfolio/springapi/application/healthrecord/service/HealthRecordServiceTest.java b/spring-api/src/test/java/koh/portfolio/springapi/application/healthrecord/service/HealthRecordServiceTest.java
