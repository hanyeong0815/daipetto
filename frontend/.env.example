# ===== API =====
# 実行環境（Web / Android / iOS）をCapacitorが自動判定し、対応するURLを使用する。
# .env自体を書き換える必要はない（値を変えるのはAPIサーバーのホスト/ポートを変更する時のみ）。

# Web（ブラウザ・vite dev server）
VITE_API_BASE_URL_WEB=http://localhost:8080

# Capacitor Android（エミュレーターからホストPCへは10.0.2.2でアクセス）
VITE_API_BASE_URL_ANDROID=http://10.0.2.2:8080

# Capacitor iOS（シミュレーターはホストPCとlocalhostを共有）
VITE_API_BASE_URL_IOS=http://localhost:8080
