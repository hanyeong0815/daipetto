# ===== Database (local) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=daipetto
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# ===== JWT =====
# 本番環境では必ず32文字以上のランダム文字列に変更すること
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=14

# ===== CORS (Docker profile用) =====
# カンマ区切りで複数指定可能
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost,capacitor://localhost
